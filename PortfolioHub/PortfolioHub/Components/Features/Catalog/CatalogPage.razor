@page "/"
@inject IStringLocalizer<SharedResource> L

@* Home page: hero + app catalog. Project data lives in memory until the hub has a
   database. *@

<PageTitle>@L["Catalog.Title"] · alexitp1125</PageTitle>

<section class="ph-hero">
    <HeroCity />

    <div class="ph-hero-inner">
        <div class="ph-hero-copy">
            <p class="ph-label ph-hero-eyebrow">@L["Hero.Eyebrow"]</p>
            <h1 class="ph-hero-title">@L["Hero.TitleLead"] <span class="ph-gradient-text">@L["Hero.TitleAccent"]</span></h1>
            <p class="ph-hero-sub">@L["Hero.Subtitle"]</p>

            <div class="ph-hero-actions">
                <a class="ph-btn ph-btn--primary" href="#projects">
                    @L["Hero.ViewProjects"] <i class="bi bi-arrow-down" aria-hidden="true"></i>
                </a>
                <a class="ph-btn ph-btn--ghost" href="https://github.com/Alexitp1125"
                   target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-github" aria-hidden="true"></i> GitHub
                </a>
            </div>
        </div>
    </div>
</section>

<section id="projects" class="ph-page ph-catalog">
    <h2 class="ph-catalog-title">@L["Catalog.Title"]</h2>

    <div class="ph-grid">
        <ProjectCard Project="Player" Number="1">
            <Media>
                <svg class="ph-art" viewBox="0 0 320 180" aria-hidden="true">
                    <defs>
                        <linearGradient id="ph-player-bg" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" style="stop-color:var(--art-1)" />
                            <stop offset="1" style="stop-color:var(--art-2)" />
                        </linearGradient>
                    </defs>
                    <rect width="320" height="180" fill="url(#ph-player-bg)" />
                    <circle cx="104" cy="90" r="62" style="fill:var(--art-disc)" />
                    <g fill="none" style="stroke:var(--accent-1)" opacity=".35">
                        <circle cx="104" cy="90" r="30" />
                        <circle cx="104" cy="90" r="42" />
                        <circle cx="104" cy="90" r="54" />
                    </g>
                    <circle cx="104" cy="90" r="16" style="fill:var(--accent-3)" />
                    <circle cx="104" cy="90" r="3" style="fill:var(--art-disc)" />
                    <rect class="ph-eq" style="animation-delay:-0.00s;fill:var(--accent-1)" x="196" y="70" width="6" height="60" rx="3" />
                    <rect class="ph-eq" style="animation-delay:-0.17s;fill:var(--accent-2)" x="207" y="79" width="6" height="51" rx="3" />
                    <rect class="ph-eq" style="animation-delay:-0.34s;fill:var(--accent-3)" x="218" y="106" width="6" height="24" rx="3" />
                    <rect class="ph-eq" style="animation-delay:-0.51s;fill:var(--accent-1)" x="229" y="68" width="6" height="62" rx="3" />
                    <rect class="ph-eq" style="animation-delay:-0.68s;fill:var(--accent-2)" x="240" y="70" width="6" height="60" rx="3" />
                    <rect class="ph-eq" style="animation-delay:-0.85s;fill:var(--accent-3)" x="251" y="79" width="6" height="51" rx="3" />
                    <rect class="ph-eq" style="animation-delay:-1.02s;fill:var(--accent-1)" x="262" y="71" width="6" height="59" rx="3" />
                    <rect class="ph-eq" style="animation-delay:-1.19s;fill:var(--accent-2)" x="273" y="84" width="6" height="46" rx="3" />
                    <rect class="ph-eq" style="animation-delay:-1.36s;fill:var(--accent-3)" x="284" y="89" width="6" height="41" rx="3" />
                    <text x="196" y="152" class="ph-art-caption">NOW PLAYING</text>
                </svg>
            </Media>
        </ProjectCard>

        <ProjectCard Project="Charts" Number="2">
            <Media>
                <svg class="ph-art" viewBox="0 0 320 180" aria-hidden="true">
                    <defs>
                        <linearGradient id="ph-charts-bg" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" style="stop-color:var(--sky-1)" />
                            <stop offset="1" style="stop-color:var(--sky-3)" />
                        </linearGradient>
                        <linearGradient id="ph-charts-ring" x1="0" y1="0" x2="1" y2="0">
                            <stop offset="0" style="stop-color:var(--accent-1)" />
                            <stop offset=".5" style="stop-color:var(--accent-2)" />
                            <stop offset="1" style="stop-color:var(--accent-3)" />
                        </linearGradient>
                    </defs>
                    <rect width="320" height="180" fill="url(#ph-charts-bg)" />
                    <g style="stroke:var(--art-grid)" opacity=".7">
                        <line x1="112" y1="142" x2="-160" y2="180" />
                        <line x1="118" y1="142" x2="-120" y2="180" />
                        <line x1="124" y1="142" x2="-80" y2="180" />
                        <line x1="130" y1="142" x2="-40" y2="180" />
                        <line x1="136" y1="142" x2="0" y2="180" />
                        <line x1="142" y1="142" x2="40" y2="180" />
                        <line x1="148" y1="142" x2="80" y2="180" />
                        <line x1="154" y1="142" x2="120" y2="180" />
                        <line x1="160" y1="142" x2="160" y2="180" />
                        <line x1="166" y1="142" x2="200" y2="180" />
                        <line x1="172" y1="142" x2="240" y2="180" />
                        <line x1="178" y1="142" x2="280" y2="180" />
                        <line x1="184" y1="142" x2="320" y2="180" />
                        <line x1="190" y1="142" x2="360" y2="180" />
                        <line x1="196" y1="142" x2="400" y2="180" />
                        <line x1="202" y1="142" x2="440" y2="180" />
                        <line x1="208" y1="142" x2="480" y2="180" />
                        <line x1="0" y1="152" x2="320" y2="152" />
                        <line x1="0" y1="166" x2="320" y2="166" />
                    </g>
                    <path d="M46,92 a62,26 0 0,0 124,0 v15 a62,26 0 0,1 -124,0z" style="fill:var(--accent-2);stroke:var(--art-outline)" stroke-width="2" />
                    <ellipse cx="108" cy="92" rx="62" ry="26" fill="url(#ph-charts-ring)" style="stroke:var(--art-outline)" stroke-width="2" />
                    <ellipse cx="108" cy="92" rx="27" ry="11" style="fill:var(--sky-2);stroke:var(--art-outline)" stroke-width="2" />
                    <path d="M216,94 l9,-5 v38 l-9,5z" style="fill:color-mix(in srgb,var(--accent-1) 65%,var(--art-outline));stroke:var(--art-outline)" stroke-width="2" stroke-linejoin="round" />
                    <rect x="198" y="94" width="18" height="38" style="fill:var(--accent-1);stroke:var(--art-outline)" stroke-width="2" />
                    <path d="M198,94 l9,-5 h18 l-9,5z" style="fill:color-mix(in srgb,var(--accent-1) 55%,var(--cream));stroke:var(--art-outline)" stroke-width="2" stroke-linejoin="round" />
                    <path d="M246,70 l9,-5 v62 l-9,5z" style="fill:color-mix(in srgb,var(--accent-3) 65%,var(--art-outline));stroke:var(--art-outline)" stroke-width="2" stroke-linejoin="round" />
                    <rect x="228" y="70" width="18" height="62" style="fill:var(--accent-3);stroke:var(--art-outline)" stroke-width="2" />
                    <path d="M228,70 l9,-5 h18 l-9,5z" style="fill:color-mix(in srgb,var(--accent-3) 55%,var(--cream));stroke:var(--art-outline)" stroke-width="2" stroke-linejoin="round" />
                    <path d="M276,84 l9,-5 v48 l-9,5z" style="fill:color-mix(in srgb,var(--accent-2) 65%,var(--art-outline));stroke:var(--art-outline)" stroke-width="2" stroke-linejoin="round" />
                    <rect x="258" y="84" width="18" height="48" style="fill:var(--accent-2);stroke:var(--art-outline)" stroke-width="2" />
                    <path d="M258,84 l9,-5 h18 l-9,5z" style="fill:color-mix(in srgb,var(--accent-2) 55%,var(--cream));stroke:var(--art-outline)" stroke-width="2" stroke-linejoin="round" />
                </svg>
            </Media>
        </ProjectCard>

        <article class="ph-next">
            <div>
                <img class="ph-next-rako" src="brand/rako-empty.svg" alt="" width="104" height="104" />
                <h3 class="ph-next-title">@L["Next.Title"]</h3>
                <p class="ph-next-text">@L["Next.Body"]</p>
            </div>
        </article>
    </div>
</section>

@code {
    // Mixtape: music player; audio plays through YouTube's official player. Installable (CONVENTIONS §11).
    private Project Player => new()
    {
        Title = L["Project.Player.Title"],
        Tagline = L["Project.Player.Tagline"],
        Tags = ["Blazor", "C#", "YouTube API"],
        Status = ProjectStatus.Live,
        AppUrl = "https://mixtape.alexitp1125.com",
        Installable = true
    };

    // Chartwave: 3D chart generator (v1: donut). Not installable yet (CONVENTIONS §11 comes in v1.1).
    private Project Charts => new()
    {
        Title = L["Project.Charts.Title"],
        Tagline = L["Project.Charts.Tagline"],
        Tags = ["Blazor", "C#", "TypeScript"],
        Status = ProjectStatus.Live,
        AppUrl = "https://chartwave.alexitp1125.com"
    };
}
