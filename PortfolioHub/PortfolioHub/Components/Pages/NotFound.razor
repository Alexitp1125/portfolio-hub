@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NotFound.Title"] · alexitp1125</PageTitle>

<section class="ph-notfound">
    <img class="ph-notfound-rako" src="brand/rako-error.svg" alt="" width="180" height="180" />
    <p class="ph-label ph-notfound-code">Error 404</p>
    <h1 class="ph-notfound-title">@L["NotFound.Lead"] <span class="ph-gradient-text">@L["NotFound.Accent"]</span></h1>
    <p class="ph-notfound-text">@L["NotFound.Body"]</p>
    <a class="ph-btn ph-btn--primary" href="">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> @L["NotFound.Back"]
    </a>
</section>
