@* City scene behind the home hero. Colors come from the theme variables in
   HeroCity.razor.css. The sun (light) and the moon (dark) sit in their own layer,
   placed from the top of the hero, so they stay visible at any screen size. *@

<div class="ph-city" aria-hidden="true">
    <svg class="ph-city-sky" viewBox="0 0 400 400">
        <defs>
            <radialGradient id="ph-city-glow">
                <stop offset="0" style="stop-color:var(--glow);stop-opacity:.55" />
                <stop offset="1" style="stop-color:var(--glow);stop-opacity:0" />
            </radialGradient>
            <linearGradient id="ph-city-sun" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" style="stop-color:var(--sun-1)" />
                <stop offset="1" style="stop-color:var(--sun-2)" />
            </linearGradient>
            <mask id="ph-city-crescent">
                <rect width="400" height="400" fill="#fff" />
                <circle cx="228" cy="178" r="58" fill="#000" />
            </mask>
            <mask id="ph-city-sun-bars">
                <rect width="400" height="400" fill="#fff" />
                <rect x="120" y="212" width="160" height="5" fill="#000" />
                <rect x="120" y="228" width="160" height="6" fill="#000" />
                <rect x="120" y="245" width="160" height="7" fill="#000" />
            </mask>
        </defs>
        <circle cx="200" cy="200" r="190" fill="url(#ph-city-glow)" />
        <circle cx="200" cy="200" r="66" mask="url(#ph-city-crescent)" style="fill:var(--moon);opacity:var(--moon-op)" />
        <circle cx="200" cy="200" r="66" fill="url(#ph-city-sun)" mask="url(#ph-city-sun-bars)" style="opacity:var(--sun-op)" />
    </svg>

